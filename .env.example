# Copy to .env and edit. Every variable is optional; defaults are shown.

# GitHub (no auth needed; a free token raises the limit from 60 to 5,000 requests/hour)
GITHUB_API_URL=https://api.github.com
GITHUB_TOKEN=
HTTP_TIMEOUT_SECONDS=15
HTTP_RETRIES=2               # for timeouts and 5xx

# Cache / offline
DATA_DIR=./data
CACHE_TTL_SECONDS=600
OFFLINE_MODE=false           # serve only recorded fixtures/cache, never touch the network
SEED_ON_STARTUP=true         # load recorded fixtures into the cache on startup

# Tool limits
MAX_FILE_BYTES=100000        # larger files are truncated
MAX_SEARCH_RESULTS=30
MAX_ISSUES=50

# HTTP transport: Host headers accepted (DNS-rebinding protection)
ALLOWED_HOSTS=localhost:*,127.0.0.1:*,server:*
ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*   # browser pages allowed to call /mcp

# Demo agent (python -m client). Leave GROQ_API_KEY empty to use the rule-based planner.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
AGENT_MAX_STEPS=6
